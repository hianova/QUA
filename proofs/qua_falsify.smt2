; QUA v1.0.0 — Pure QF_LIA Surface Code Correction Radius & Huber E-Process Bounds
(set-logic QF_LIA)

(declare-const d Int)
(declare-const w_err Int)
(declare-const w_corr Int)

; CHECK 1: Anti-vacuity for rotated surface code d in {3, 5, 7} (expect SAT)
(push)
(assert (or (= d 3) (= d 5) (= d 7)))
(assert (<= 1 w_err))
(assert (<= (* 2 w_err) (- d 1)))
(assert (and (<= 0 w_corr) (<= w_corr w_err)))
(check-sat)
(pop)

; CHECK 2: Exact MWPM correction radius — error + MWPM correction weight < d (expect UNSAT)
(push)
(assert (or (= d 3) (= d 5) (= d 7)))
(assert (and (<= 0 w_err) (<= (* 2 w_err) (- d 1))))
(assert (and (<= 0 w_corr) (<= w_corr w_err)))
(assert (>= (+ w_err w_corr) d))
(check-sat)
(pop)

; CHECK 3: Honest Theory Falsification — burst error beyond (d-1)/2 causes logical failure (expect SAT)
(push)
(assert (= d 3))
(assert (= w_err 2))
(assert (= w_corr 1))
(assert (> (* 2 w_err) (- d 1)))
(assert (>= (+ w_err w_corr) d))
(check-sat)
(pop)

; CHECK 4: Huber glitch-clipping upper bound across lambda in {1,2,4,8} (expect UNSAT)
(declare-const z_clip Int)
(declare-const huber_b Int)
(declare-const half_lam2 Int)
(declare-const lam Int)
(push)
(assert (> huber_b 0))
(assert (>= half_lam2 0))
(assert (and (>= z_clip (- huber_b)) (<= z_clip huber_b)))
(assert (or
  (and (= lam 1) (> (- (* 1 z_clip) half_lam2) (* 1 huber_b)))
  (and (= lam 2) (> (- (* 2 z_clip) half_lam2) (* 2 huber_b)))
  (and (= lam 4) (> (- (* 4 z_clip) half_lam2) (* 4 huber_b)))
  (and (= lam 8) (> (- (* 8 z_clip) half_lam2) (* 8 huber_b)))))
(check-sat)
(pop)
