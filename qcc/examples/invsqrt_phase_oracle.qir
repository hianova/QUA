(qir "invsqrt_phase_oracle"
  (clean_anc)
  (input %x u8)
  (let %y u8 (approx_fn %x :fn invsqrt :seg 4 :deg 2 :frac 6))
  (let %ph u0 (phase_poly (%y)
    (and 0x1  :turns 0.00390625)
    (and 0x2  :turns 0.0078125)
    (and 0x4  :turns 0.015625)
    (and 0x8  :turns 0.03125)
    (and 0x10 :turns 0.0625)
    (and 0x20 :turns 0.125)
    (and 0x40 :turns 0.25)
    (and 0x80 :turns 0.5)))
  (output %x)
)
