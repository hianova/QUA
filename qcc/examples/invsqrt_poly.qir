(qir "invsqrt_poly"
  (input %x u8)
  (let (%mant u6 %clz u4) (clz_norm %x 6))
  (let %xsq u6 (sqr_fxp %mant :frac 5 5 :approx 131072))
  (let %slope u6 (const 19))
  (let %corr u6 (mul_fxp %xsq %slope :frac 5 5 5 :approx 131072))
  (let %c0 u6 (const 48))
  (let %approx_y u6 (sub %c0 %corr))
  (output %approx_y)
  (output %clz)
)
